<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CustomerApp.MainWindow"
    Title="MB06 Kundenverwaltung · Solution"
    Width="820"
    Height="560"
    MinWidth="680"
    MinHeight="460"
    Loaded="Window_Loaded"
    Language="de-CH">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.ColumnSpan="3"
            Text="Kunden: Auswahl und Details"
            FontSize="22"
            FontWeight="Bold"
            Margin="0,0,0,15" />
        <ListBox
            x:Name="CustomersList"
            Grid.Row="1"
            SelectionChanged="Customers_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="{Binding CompanyName}"
                            FontWeight="Bold" />
                        <TextBlock Text="{Binding ContactName}"/>
                        <TextBlock Text="{Binding Phone}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel
            Grid.Row="1"
            Grid.Column="2">
            <TextBlock Text="CustomerID"/>
            <TextBlock
                x:Name="IdText"
                Text="{Binding CustomerID}"
                FontWeight="Bold" />
            <TextBlock
                Text="Firma"
                Margin="0,12,0,3" />
            <TextBox
                x:Name="CompanyNameBox"
                Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Padding="6" />
            <TextBlock
                Text="Kontakt"
                Margin="0,12,0,3" />
            <TextBox
                x:Name="ContactNameBox"
                Text="{Binding ContactName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Padding="6" />
            <TextBlock
                Text="Telefon"
                Margin="0,12,0,3" />
            <TextBox
                x:Name="PhoneBox"
                Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Padding="6" />
            <Button
                Content="Firma per Code ändern"
                Click="Rename_Click"
                Margin="0,8" />
            <Button
                Content="Kunde hinzufügen"
                Click="Add_Click" />
            <Button
                Content="Auswahl entfernen"
                Click="Remove_Click"
                Margin="0,8" />
        </StackPanel>
        <DockPanel
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,16,0,0">
            <Button
                DockPanel.Dock="Right"
                Content="Speichern"
                Click="Save_Click"
                Padding="18,7" />
            <TextBlock
                x:Name="StatusText"
                Text="Bereit"
                TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
